#!/usr/bin/env bash
# Stub `docker`: records every call (argv) and prints nothing sensitive.
echo "docker $*" >>"${STUB_CALLS_LOG:?}"
state="${STUB_STATE_DIR:?}/digest"
case "$1" in
  login) cat >/dev/null ;;
  pull) echo "sha256:new" >"$state"; echo "Status: Downloaded newer image for $2" ;;
  image) [ -f "$state" ] && cat "$state" || echo "sha256:old" ;;
  rm) echo "$3" ;;
  run)
    # T-055: STUB_ENV_DUMP=<file> records the environment `docker run` inherits.
    [ -z "${STUB_ENV_DUMP:-}" ] || env >"$STUB_ENV_DUMP"
    # STUB_DOCKER_RUN_FAIL=<code>: make `docker run` fail with that exit status.
    [ -z "${STUB_DOCKER_RUN_FAIL:-}" ] || { echo "docker: Error response from daemon" >&2; exit "$STUB_DOCKER_RUN_FAIL"; }
    echo "container-id-stub" ;;
esac
exit 0
