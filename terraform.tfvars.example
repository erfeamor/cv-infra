aws_region   = "eu-west-3"
project_name = "cv-project"
environment  = "dev"

db_name     = "cv"
db_username = "cv"
db_password = "REPLACE_ME"

domain_service_instance_type = "t3.micro"

# t3.small (T-002, H1 decision 2): a Free Tier exception, net ~+$8/mo
# (~$16.60 vs ~$8.30) -- see variables.tf for the full accounting. Needed
# for Jenkins + Maven headroom alongside Drone; the docs correction is T-003.
drone_instance_type        = "t3.small"
drone_admin_username       = "erfeamor"
drone_rpc_secret           = "REPLACE_ME" # openssl rand -hex 16
drone_github_client_id     = "REPLACE_ME"
drone_github_client_secret = "REPLACE_ME"

jenkins_admin_username = "erfeamor"
jenkins_admin_password = "REPLACE_ME" # openssl rand -base64 24
github_pat_ci          = "REPLACE_ME" # repo:status scope only (classic) or fine-grained Commit-statuses:read/write on cv-domain-service + cv-database

# T-011: two budget alarms, both tracking gross usage (include_credit =
# false, see budgets.tf) -- they answer two different questions and must
# never share a limit variable (that sharing was a real bug, fixed in the
# H1 2026-08-09 scope amendment).

# budget_credit_balance_amount: the CUMULATIVE remaining Free Tier credit
# pot, tracked by the ANNUALLY aws_budgets_budget.credit_runway.
# REPLACE_ME_MEASURED_USD is a deliberate, obviously-fake placeholder -- do
# not treat it as a real limit. The real figure is a console read
# (Billing -> Credits), not a guess.
budget_credit_balance_amount = "REPLACE_ME_MEASURED_USD"

# budget_monthly_limit_amount: the MONTHLY anomaly-detector limit for
# aws_budgets_budget.gross_usage, sized slightly above the known ~$28/month
# baseline burn so it fires when burn accelerates, not on ordinary usage.
# Ships with a real default (see variables.tf) since it's a ratified design
# margin over an already-measured baseline, not a value needing a fresh
# console read -- override here only if the baseline burn rate changes.
budget_monthly_limit_amount = "35"

budget_notification_thresholds = [50, 80, 100]
budget_notification_emails     = ["REPLACE_ME@example.com"]
