aws_region   = "eu-west-3"
project_name = "cv-project"
environment  = "dev"

db_name     = "cv"
db_username = "cv"
db_password = "REPLACE_ME"

domain_service_instance_type = "t3.micro"

# t3.small (T-002, H1 decision 2): a Free Tier exception, net ~+$8/mo
# (~$16.60 vs ~$8.30) -- see variables.tf for the full accounting. Needed
# for Jenkins + Maven headroom alongside Drone; the docs correction is T-003.
drone_instance_type        = "t3.small"
drone_admin_username       = "erfeamor"
drone_rpc_secret           = "REPLACE_ME" # openssl rand -hex 16
drone_github_client_id     = "REPLACE_ME"
drone_github_client_secret = "REPLACE_ME"

jenkins_admin_username = "erfeamor"
jenkins_admin_password = "REPLACE_ME" # openssl rand -base64 24
github_pat_ci          = "REPLACE_ME" # repo:status scope only (classic) or fine-grained Commit-statuses:read/write on cv-domain-service + cv-database
