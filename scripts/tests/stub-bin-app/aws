#!/usr/bin/env bash
# Stub `aws` for run-cv-redeploy-tests.sh. Logs argv (secrets are only ever
# RETURNED to the caller, never logged) and serves fixed SSM values.
echo "aws $*" >>"${STUB_CALLS_LOG:?}"
# T-068: the host has no public IPv4, so every aws call must carry the dual-stack flag.
[ "${AWS_USE_DUALSTACK_ENDPOINT:-}" = true ] || echo "NODUALSTACK aws $*" >>"$STUB_CALLS_LOG"
case "$1 $2" in
  "ssm get-parameter")
    name=""
    while [ "$#" -gt 0 ]; do [ "$1" = "--name" ] && name="$2"; shift; done
    # T-055: STUB_AWS_FAIL / STUB_AWS_EMPTY = a substring of the parameter name
    # whose read should fail (exit 254) / come back empty.
    if [ -n "${STUB_AWS_FAIL:-}" ] && [[ "$name" == *"$STUB_AWS_FAIL"* ]]; then
      echo "An error occurred (ThrottlingException) when calling GetParameter" >&2
      exit 254
    fi
    if [ -n "${STUB_AWS_EMPTY:-}" ] && [[ "$name" == *"$STUB_AWS_EMPTY"* ]]; then
      echo ""
      exit 0
    fi
    case "$name" in
      */db/password) echo "SECRET-DB-PASSWORD-1" ;;
      */bff/service-client-secret) echo "SECRET-BFF-CLIENT-2" ;;
      */cognito/issuer-uri) echo "https://issuer.example/pool" ;;
      */app/cors-allowed-origins) echo "https://example.test,https://d111.cloudfront.net" ;;
      # unique per parameter, so a swapped parameter->variable mapping is visible
      *) echo "value-of-${name#/cv-project/dev/}" ;;
    esac
    ;;
  "s3 cp")
    # T-070: STUB_S3 selects the outcome of reading the migration SQL object.
    #   (unset)  copy $STUB_S3_FILE to the destination
    #   missing  the 404 the AWS CLI prints for a key that does not exist
    #   denied   a 403 (the role may not read it)
    dest="${*: -1}"
    case "${STUB_S3:-ok}" in
      ok) cp "${STUB_S3_FILE:?}" "$dest" ;;
      missing) echo "fatal error: An error occurred (404) when calling the HeadObject operation: Key \"migrations/cv-database-sql.tgz\" does not exist" >&2; exit 1 ;;
      denied) echo "fatal error: An error occurred (403) when calling the HeadObject operation: Forbidden" >&2; exit 1 ;;
    esac
    ;;
  "ecr get-login-password") echo "SECRET-ECR-TOKEN-3" ;;
  *) echo "stub aws: unexpected $*" >&2; exit 1 ;;
esac
